# ============================================================
# ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your Supabase values
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only — never prefix these with NEXT_PUBLIC_, that ships
# them to the browser. Used by src/app/api/staff/* to verify staff
# PINs and sign session cookies. Set in Vercel, never committed.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
STAFF_SESSION_SECRET=a-long-random-string
